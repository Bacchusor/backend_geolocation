{
  "name": "georeminder",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/shared build && pnpm -r --filter ./apps/* build",
    "dev:api": "pnpm --filter @georeminder/api dev",
    "dev:admin": "pnpm --filter @georeminder/admin dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @georeminder/api test:unit && pnpm --filter @georeminder/shared test",
    "test:integration": "pnpm --filter @georeminder/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
