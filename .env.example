# GeoReminder — configuration (copy to .env; in Portainer paste as the stack's environment variables).
# Every variable the containers read is listed here. Secrets: generate with `openssl rand -hex 32`.

# ---- Images (compose) ----
IMAGE_REGISTRY=ghcr.io/bacchusor        # where CI publishes georeminder-api / georeminder-admin
IMAGE_TAG=pre                            # `pre` = latest build of main; or a branch name / commit SHA
API_PORT=3000                            # host port for the API (Home Assistant must reach it)
ADMIN_PORT=3080                          # host port for the admin UI (nginx, proxies /api to the API)
TZ=Europe/Bucharest                      # rule time windows and daily caps are evaluated in this zone

# ---- Database (postgis service + API) ----
POSTGRES_USER=georeminder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=georeminder
POSTGIS_IMAGE=imresamu/postgis:16-3.5   # multi-arch (amd64 + arm64) build of PostgreSQL 16 + PostGIS 3.5; postgis/postgis has no arm64 image
# DATABASE_URL is derived in docker-compose.yml; for local dev without compose:
# DATABASE_URL=postgres://georeminder:change-me@localhost:5432/georeminder
# RUN_MIGRATIONS=true                    # run idempotent migrations on API start (default true)

# ---- Security ----
API_KEY=change-me-32-hex                 # header `x-api-key` for machine clients (Home Assistant, future app backend), >= 16 chars
JWT_SECRET=change-me-64-hex              # signs the admin session cookie, >= 32 chars
ENCRYPTION_KEY=change-me-64-hex          # AES-256-GCM key (exactly 64 hex chars) for Notion / Home Assistant tokens at rest
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me                 # admin UI login, >= 8 chars
COOKIE_SECURE=false                      # true when the admin is served over HTTPS
CORS_ORIGINS=                            # comma-separated origins allowed to call the API cross-site (empty = none; the admin uses the nginx proxy)
PUBLIC_API_URL=http://192.168.1.111:3000 # shown in the OpenAPI document

# ---- Home Assistant ----
HA_URL=http://192.168.1.119:8123         # optional: bootstraps a "Home Assistant" channel on first start
HA_TOKEN=                                # optional: long-lived access token for that channel (stored encrypted)
HA_ZONE_SYNC=true                        # mirror active places as HA zones (uses the first HA channel)
HA_ZONE_PREFIX=GR                        # zone name prefix -> entity ids like zone.gr_lidl (note the trailing space in compose default "GR ")
# HA_ZONE_WARN_LIMIT=20                  # warn when more active places than iOS geofences

# ---- Geocoding (admin address search) ----
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GeoReminder/0.1 (self-hosted; contact: you@example.com)

# ---- Location ingestion / evaluation ----
LOCATION_MIN_INTERVAL_SECONDS=5          # per-person throttle on POST /v1/location
MAX_SPEED_MPS=100                        # fixes implying a faster move within 1 h are rejected as implausible
MAX_FIX_AGE_HOURS=24                     # older fixes are ignored
EXIT_HYSTERESIS_FACTOR=1.25              # exit radius = enter/approach radius x this factor

# ---- Retention & workers ----
EVENT_RETENTION_DAYS=30                  # rule_events older than this are purged
# RETENTION_INTERVAL_MINUTES=60
NOTION_SYNC_ENABLED=true                 # background Notion sync worker (interval configured in the admin UI)

# ---- Logging ----
LOG_LEVEL=info                           # fatal|error|warn|info|debug|trace ; coordinates are only logged at debug, rounded to 3 decimals
# LOG_PRETTY=false                       # human-readable logs for local dev
