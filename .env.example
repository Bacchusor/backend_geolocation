# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=false

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://geo:geo@localhost:5432/geo
DATABASE_SSL=false

# Auth: provide either a shared HS256 secret (dev) or a JWKS URL (prod)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
JWT_ISSUER=https://your-idp.example.com/
JWT_AUDIENCE=geolocation-api

# Geocoding provider: nominatim (no key) | mapbox
GEOCODER_PROVIDER=nominatim
# MAPBOX_ACCESS_TOKEN=pk.xxx
# Nominatim usage policy requires an identifying User-Agent with contact info
NOMINATIM_USER_AGENT=backend-geolocation/0.1 (ops@example.com)
GEOCODE_CACHE_TTL_SECONDS=2592000

# Domain rules
MAX_NEARBY_RADIUS_M=50000
MAX_FIX_AGE_SECONDS=600
MAX_SPEED_MPS=350
MAX_ACCEPTED_ACCURACY_M=500
HISTORY_RETENTION_DAYS=30
